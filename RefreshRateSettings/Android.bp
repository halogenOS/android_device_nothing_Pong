android_app {
    name: "RefreshRateSettings",
    srcs: ["custom/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.preference_preference",
        "SettingsLib",
        "SettingsLibSettingsTheme",
    ],
}
