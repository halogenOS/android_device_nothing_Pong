cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.nothing",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.nothing.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.nothing.xml"],
    local_include_dirs: ["include"],
    cflags: [
        "-O3",
    ],
    srcs: [
        "CancellationSignal.cpp",
        "Fingerprint.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "libdl",
        "liblog",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
        "android.hardware.biometrics.common.config",
    ],
    static_libs: ["libandroid.hardware.biometrics.fingerprint.NothingProps"],
    lto: { thin: true },
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.NothingProps",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}

cc_binary {
    name: "custom.hardware.biometrics.fingerprint.udfps-service.nothing",
    vintf_fragments: ["custom.hardware.biometrics.fingerprint.udfps-service.nothing.xml"],
    init_rc: ["custom.hardware.biometrics.fingerprint.udfps-service.nothing.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "UdfpsExtension.cpp",
        "udfps_service.cpp",
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "custom.hardware.biometrics.fingerprint.udfps-V1-ndk",
    ],
}
