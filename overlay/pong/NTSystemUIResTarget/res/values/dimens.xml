<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">45px</dimen>

    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">20px</dimen>

    <dimen name="keyguard_indication_margin_bottom">320px</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1009px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">64.4</item>

    <!-- The position of the volume dialog on the screen.
         See com.android.systemui.volume.VolumeDialogImpl.
         Value 19 corresponds to LEFT|CENTER_VERTICAL. -->
    <integer name="volume_dialog_gravity">19</integer>

    <!-- For burn-in protection -->
    <dimen name="status_bar_offset_max_y">2dp</dimen>
    <dimen name="burn_in_prevention_offset_x">2dp</dimen>
    <dimen name="burn_in_prevention_offset_y">4dp</dimen>
    <dimen name="burn_in_prevention_offset_y_clock">16dp</dimen>
    <dimen name="default_burn_in_prevention_offset">4dp</dimen>
    <dimen name="udfps_burn_in_offset_x">6px</dimen>
    <dimen name="udfps_burn_in_offset_y">8px</dimen>

</resources>
