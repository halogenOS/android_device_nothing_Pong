<resources>
    <!-- Device-specific conformance attributes: properties this device has
         that the claimed (certified) device does not — partitions that are
         empty on stock carry no ro.product.<part>.* set, the OEM feature
         props are vendor-specific, and the HAL service bookkeeping names this
         device's services. SYSPROP_HIDE makes spoof-target processes answer
         "no such property" for them, matching stock. -->
    <string-array name="control_conformance_attributes_device" translatable="false">
        <item>SYSPROP_HIDE.ro.product.odm.brand</item>
        <item>SYSPROP_HIDE.ro.product.odm.device</item>
        <item>SYSPROP_HIDE.ro.product.odm.manufacturer</item>
        <item>SYSPROP_HIDE.ro.product.odm.model</item>
        <item>SYSPROP_HIDE.ro.product.odm.name</item>
        <item>SYSPROP_HIDE.ro.product.bootimage.brand</item>
        <item>SYSPROP_HIDE.ro.product.bootimage.device</item>
        <item>SYSPROP_HIDE.ro.product.bootimage.manufacturer</item>
        <item>SYSPROP_HIDE.ro.product.bootimage.model</item>
        <item>SYSPROP_HIDE.ro.product.bootimage.name</item>
        <item>SYSPROP_HIDE.ro.build.nothing.feature.base</item>
        <item>SYSPROP_HIDE.ro.build.nothing.feature.diff.device.Pong</item>
        <item>SYSPROP_HIDE.init.svc.ltpo-hal-pong</item>
        <item>SYSPROP_HIDE.init.svc.vendor.fingerprint-nothing</item>
        <item>SYSPROP_HIDE.init.svc_debug_pid.custom.hardware.biometrics.fingerprint.udfps-nothing</item>
